{
  "name": "@hey-research-lab/plugin-hey-research",
  "version": "0.1.0",
  "description": "ElizaOS plugin for HEY Research Lab: lets an agent check whether a Robinhood Chain project is still building, what it shipped and what HEY does not know, by name, ticker or contract, with evidence links. Read-only, no key required.",
  "license": "MIT",
  "author": "HEY Research Lab",
  "type": "module",
  "sideEffects": false,
  "homepage": "https://heyresearch.xyz/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hey-research-lab/plugin-hey-research"
  },
  "bugs": {
    "url": "https://github.com/hey-research-lab/plugin-hey-research/issues"
  },
  "keywords": [
    "elizaos-plugin",
    "eliza-plugin",
    "elizaos",
    "plugin",
    "hey-research",
    "robinhood-chain",
    "ai-agents",
    "builders",
    "ships",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "images",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.1",
  "packageType": "plugin",
  "platform": "node",
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "HEY_API_KEY": {
        "type": "string",
        "description": "Optional HEY Research Lab API key from https://heyresearch.xyz/account. It only lifts the anonymous rate limit; every read works without it.",
        "required": false,
        "sensitive": true
      },
      "HEY_API_URL": {
        "type": "string",
        "description": "Base URL of HEY's public API (default: https://heyresearch.xyz). Change it only to point at a local HEY for testing.",
        "default": "https://heyresearch.xyz",
        "required": false,
        "sensitive": false
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "scan": "node scripts/scan.mjs .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hey-research-lab/sdk": "^0.2.0"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.7.0"
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2",
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1"
    }
  }
}
